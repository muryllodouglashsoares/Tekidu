# Copie este arquivo para ".env.local" e preencha com os valores
# encontrados em: Firebase Console → Configurações do projeto → Geral
# → Seus apps → app Web (ícone </>) → "SDK setup and configuration" → Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# E-mail de primeiro acesso (Etapa 9 — ciclo de vida de conta estilo
# SUAP, Decisão 2 = Opção B(i): 100% client-side, sem Cloud Functions).
# Provedor: EmailJS (trocado da Resend — não exige domínio próprio
# verificado, ao contrário da Resend). Sem estas variáveis, o cadastro
# de professor/aluno falha ANTES de criar qualquer coisa no Firebase —
# ver services/email/emailService.ts.
# ---------------------------------------------------------------------

# ID do "Email Service" (a conta de e-mail conectada) criado no painel
# da EmailJS (emailjs.com → Email Services).
VITE_EMAILJS_SERVICE_ID=

# ID do template de e-mail criado no painel da EmailJS (Email Templates).
VITE_EMAILJS_TEMPLATE_ID=

# Chave pública da conta EmailJS (Account → General).
VITE_EMAILJS_PUBLIC_KEY=

# Chave privada da conta EmailJS (Account → Security → API Keys).
# Opcional, mas recomendada junto com o modo "Strict" — ver
# FIREBASE_SETUP.md.
VITE_EMAILJS_PRIVATE_KEY=
