rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Lê o documento users/{uid} do próprio requisitante. Usado para
    // decidir permissões com base na role (admin/teacher/student) e
    // no status (active) armazenados em Firestore — nunca confiamos em
    // nada que venha do cliente para essa decisão.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      let profile = callerProfile();
      return isSignedIn() && profile.active == true &&
        (profile.role == 'admin' || profile.role == 'teacher');
    }

    function isActiveAdmin() {
      let profile = callerProfile();
      return isSignedIn() && profile.active == true && profile.role == 'admin';
    }

    // ---------------------------------------------------------------
    // users/{uid}
    //
    // Ponte entre o Firebase Authentication (UID) e os dados de role
    // usados pela aplicação.
    //
    // - Qualquer usuário autenticado pode LER o PRÓPRIO documento
    //   (necessário para o AuthContext descobrir a role no login).
    // - Admin/teacher com conta ativa também podem LER qualquer
    //   documento de "users". Esta é uma extensão feita para a
    //   funcionalidade de Disciplinas: o formulário precisa listar os
    //   professores disponíveis (campo "Professor responsável"), o que
    //   exige uma consulta (`where role == 'teacher'`) além do próprio
    //   documento. Sem esta extensão, a consulta seria negada pelo
    //   servidor mesmo com a UI funcionando. A extensão segue o mesmo
    //   padrão de acesso já usado em `students`/`classes`: apenas
    //   leitura por staff ativo — criar, atualizar e excluir usuários
    //   continuam bloqueados pelo cliente (allow write: if false).
    // - Ninguém pode CRIAR, ATUALIZAR ou DELETAR pelo cliente.
    //   A criação de usuários nesta etapa é manual, feita pelo
    //   Firebase Console (ver seção "DADOS DO FIRESTORE" da explicação).
    //   Isso é intencional: enquanto não existir um fluxo de
    //   administração (Cloud Function ou tela de admin) que valide
    //   quem pode virar "admin"/"teacher"/"student", não é seguro
    //   deixar o próprio cliente escrever sua role.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isActiveStaff());
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // students/{studentId}
    //
    // Cadastro (roster) de alunos, gerenciado nesta fase por admins e
    // professores. Ainda não existe uma ligação entre um documento em
    // "students" e uma conta de aluno autenticada (isso é necessário
    // para o Boletim, que é uma fase futura) — por isso a role
    // "student" não tem acesso a esta coleção ainda.
    //
    // - LEITURA/ESCRITA: apenas admin/teacher com conta ativa
    //   (checado via users/{uid}, nunca confiando em dados do cliente).
    // - EXCLUSÃO: restrita a admin, para evitar que um professor
    //   remova permanentemente o cadastro de um aluno por engano.
    // ---------------------------------------------------------------
    match /students/{studentId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isActiveAdmin();
    }

    // ---------------------------------------------------------------
    // classes/{classId}
    //
    // Cadastro de turmas (Fase 7). A quantidade de alunos exibida na
    // listagem é calculada no cliente a partir de `students.turma`
    // (texto livre) — não há um campo de contagem armazenado aqui, e
    // por isso nenhuma regra adicional é necessária além da leitura
    // de `students`, já coberta acima.
    //
    // Mesma política de acesso de `students`: admin/teacher ativos
    // podem ler/criar/editar; apenas admin pode excluir.
    // ---------------------------------------------------------------
    match /classes/{classId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isActiveAdmin();
    }

    // ---------------------------------------------------------------
    // disciplines/{disciplineId}
    //
    // Cadastro de disciplinas. A relação com turmas é feita por IDs
    // (`classIds`, referenciando `classes/{classId}`) e a quantidade de
    // alunos exibida na UI é derivada no cliente a partir de
    // `students.turma`, assim como acontece em `classes` — por isso
    // nenhuma regra adicional é necessária além da leitura de
    // `students`/`classes`, já cobertas acima.
    //
    // Mesma política de acesso de `classes`: admin/teacher ativos podem
    // ler/criar/editar; apenas admin pode excluir.
    // ---------------------------------------------------------------
    match /disciplines/{disciplineId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isActiveAdmin();
    }

    // Nenhuma outra coleção existe ainda. Por padrão, o Firestore nega
    // tudo que não tem uma regra explícita — não é necessário (nem
    // recomendado) adicionar um "match /{document=**}" de bloqueio,
    // pois isso já é o comportamento padrão de segurança.
  }
}
