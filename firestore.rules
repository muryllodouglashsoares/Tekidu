rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Lê o documento users/{uid} do próprio requisitante. Usado para
    // decidir permissões com base na role (admin/teacher/student) e
    // no status (active) armazenados em Firestore — nunca confiamos em
    // nada que venha do cliente para essa decisão.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      let profile = callerProfile();
      return isSignedIn() && profile.active == true &&
        (profile.role == 'admin' || profile.role == 'teacher');
    }

    function isActiveAdmin() {
      let profile = callerProfile();
      return isSignedIn() && profile.active == true && profile.role == 'admin';
    }

    // Tarefa 3 (Fase 1 pós-auditoria V8 — Portal do Aluno).
    function isActiveStudent() {
      let profile = callerProfile();
      return isSignedIn() && profile.active == true && profile.role == 'student';
    }

    // Resolve se o documento de aluno referenciado por `studentId`
    // (o ID do documento em `students`, NUNCA o uid de Auth — ver nota
    // de denormalização em `types/grade.ts`/`types/attendance.ts`)
    // pertence ao aluno autenticado que está fazendo a requisição.
    // Mesmo padrão de custo já aceito em `isOwnDiscipline` (um `get()`
    // extra por leitura do PRÓPRIO registro; não afeta o caminho de
    // leitura de staff, que continua sendo só `isActiveStaff()`, sem
    // nenhum `get()` adicional).
    //
    // COMPATIBILIDADE COM QUERIES (list): esta função só é segura de
    // usar em cima de uma query que já filtra `where('studentId', '==',
    // <um valor fixo>)` — é isso que permite ao Firestore provar, sem
    // avaliar documento por documento em tempo de execução, que TODOS
    // os resultados possíveis satisfazem a regra (o `get()` resolve
    // sempre para o MESMO documento `students/{studentId}`, já que o
    // valor é fixado pela própria query, não pelo documento retornado).
    // Uma query sem esse filtro (ex.: buscando o contexto inteiro de
    // uma disciplina/turma/bimestre, todos os alunos juntos) é negada
    // pelo servidor mesmo que o aluno só devesse ver uma fração do
    // resultado — daí `gradeService.getGradesByContext`/
    // `attendanceRecordService.getRecordsByContext` aceitarem um
    // `studentId` opcional que estreita a query quando quem está
    // consultando é o próprio aluno (ver `boletimService.getStudentBoletim`).
    function isOwnStudentRecord(studentId) {
      return isActiveStudent() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.uid == request.auth.uid;
    }

    // Item 13 do plano V8 ("Refinar permissões" — menor privilégio
    // necessário): um professor só pode ESCREVER (criar/editar/excluir)
    // avaliações/notas/aulas/presença de uma disciplina da qual ele é o
    // `teacherId`. Um `get()` extra por escrita é aceitável aqui (não
    // afeta leitura, que é o caminho de maior volume) e evita confiar em
    // qualquer campo enviado pelo cliente — a checagem é sempre contra o
    // documento `disciplines/{disciplineId}` já salvo no servidor.
    // Admins continuam com acesso irrestrito (`isActiveStaff()` cobre
    // admin OU teacher; esta função é usada em conjunto com ela, nunca
    // sozinha, para não bloquear admins).
    function isOwnDiscipline(disciplineId) {
      let discipline = get(/databases/$(database)/documents/disciplines/$(disciplineId)).data;
      return discipline.teacherId == request.auth.uid;
    }

    function canWriteAcademicRecord(disciplineId) {
      let profile = callerProfile();
      return isSignedIn() && profile.active == true &&
        (profile.role == 'admin' || (profile.role == 'teacher' && isOwnDiscipline(disciplineId)));
    }

    // -----------------------------------------------------------------
    // Validação de payload (Fase 1 pós-auditoria V8, item "Tarefa 1").
    //
    // As funções `canWriteAcademicRecord`/`isActiveStaff` acima decidem
    // QUEM pode escrever, mas nunca validaram O QUE está sendo escrito.
    // Isso permitia, via chamada direta à API (contornando o frontend),
    // gravar uma nota fora da escala, um peso negativo ou um status de
    // frequência inexistente. As funções abaixo fecham essa lacuna.
    //
    // Os valores literais usados aqui (0/10 para nota, 'present'/'absent'
    // para presença) são cópias hardcoded dos valores definidos em
    // `src/types/grade.ts` (GRADE_MIN/GRADE_MAX) e
    // `src/types/attendance.ts` (AttendanceRecordStatus) — as rules do
    // Firestore não importam TypeScript, então essas constantes não
    // podem ser referenciadas diretamente daqui. Caso os valores em
    // `types/grade.ts`/`types/attendance.ts` mudem, estas funções
    // precisam ser atualizadas manualmente em conjunto.
    // -----------------------------------------------------------------

    // `score` é opcional-nulo: `null` representa "nota não lançada"
    // (ver nota em `types/grade.ts`), então é um valor válido além da
    // faixa numérica 0–10.
    function isValidScore(score) {
      return score == null || (score is number && score >= 0 && score <= 10);
    }

    // `weight` só existe em avaliações criadas após o item 4 do plano
    // V8 (retrocompatível — ver `types/assessment.ts`), por isso o
    // campo é opcional no schema. Quando presente, precisa ser um
    // número maior que 0 (peso zero/negativo não faz sentido em uma
    // média ponderada — ver `effectiveWeight` em `types/assessment.ts`,
    // que já trata peso inválido como 1 no cálculo, mas isso não deve
    // ser usado como desculpa para permitir gravar um valor inválido).
    function isValidAssessmentWeight() {
      return !('weight' in request.resource.data) ||
        request.resource.data.weight == null ||
        (request.resource.data.weight is number && request.resource.data.weight > 0);
    }

    // Enum de `AttendanceRecordStatus` (`src/types/attendance.ts`):
    // apenas "present"/"absent" existem hoje.
    function isValidAttendanceStatus(status) {
      return status == 'present' || status == 'absent';
    }

    // ---------------------------------------------------------------
    // users/{uid}
    //
    // Ponte entre o Firebase Authentication (UID) e os dados de role
    // usados pela aplicação.
    //
    // - Qualquer usuário autenticado pode LER o PRÓPRIO documento
    //   (necessário para o AuthContext descobrir a role no login).
    // - Admin/teacher com conta ativa também podem LER qualquer
    //   documento de "users". Esta é uma extensão feita para a
    //   funcionalidade de Disciplinas: o formulário precisa listar os
    //   professores disponíveis (campo "Professor responsável"), o que
    //   exige uma consulta (`where role == 'teacher'`) além do próprio
    //   documento. Sem esta extensão, a consulta seria negada pelo
    //   servidor mesmo com a UI funcionando. A extensão segue o mesmo
    //   padrão de acesso já usado em `students`/`classes`: apenas
    //   leitura por staff ativo — criar, atualizar e excluir usuários
    //   continuam bloqueados pelo cliente (allow write: if false).
    // - CRIAR: dois casos, cada um restrito ao MESMO staff que já pode
    //   criar o cadastro correspondente na coleção de domínio:
    //   (a) `role == 'teacher'`: restrito a admin ativo — a tela de
    //       "Professores" cria a conta de Authentication pelo cliente
    //       (via App secundário, ver `lib/firebase.ts`) e precisa
    //       gravar o perfil correspondente aqui. Isso substitui o
    //       cadastro manual via Firebase Console que existia antes
    //       desta funcionalidade.
    //   (b) `role == 'student'` (Tarefa 2, Fase 1 pós-auditoria V8):
    //       restrito a staff ativo (admin OU professor — o mesmo que
    //       já pode criar `students/{studentId}`, ver mais abaixo).
    //       Sem este documento, o aluno autentica no Firebase mas cai
    //       em "perfil ausente" (`/sem-perfil`, `ProtectedRoute.tsx`),
    //       pois é `users/{uid}` — não `students/{studentId}` — que
    //       toda a aplicação usa para decidir a role de quem logou.
    //   Um admin não pode usar esta regra para criar/promover a si
    //   mesmo ou outros como "admin" pelo cliente — isso continua
    //   exigindo o Console.
    // - ATUALIZAR: restrito a admin ativo, e somente para documentos
    //   com role "teacher" — mesma lógica de CRIAR (a). Diferente de
    //   CRIAR, não há hoje um fluxo de "ativar/desativar" um aluno
    //   (ver nota em `studentService.createStudent`), então UPDATE
    //   para `role == 'student'` não foi estendido nesta tarefa.
    // - DELETAR: nunca pelo cliente. Remover a CONTA de Authentication
    //   exige Admin SDK (Cloud Function), fora do escopo desta fase;
    //   por isso "excluir" um professor na UI é uma desativação lógica
    //   (`active: false`), tratada como um `update`, não um `delete`.
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isActiveStaff());
      allow create: if (isActiveAdmin() && request.resource.data.role == 'teacher') ||
        (isActiveStaff() && request.resource.data.role == 'student');
      allow update: if isActiveAdmin() &&
        resource.data.role == 'teacher' &&
        request.resource.data.role == 'teacher';
      // EXTENSÃO (Configurações — item 23 do briefing "Perfil"): permite
      // que QUALQUER usuário autenticado atualize o PRÓPRIO nome de
      // exibição. Propositalmente estreita — `hasOnly(['name'])` garante
      // que role/active/email/uid/createdAt não podem ser alterados por
      // este caminho, então isto NÃO abre brecha para autopromoção nem
      // para reativar/desativar a própria conta. Sem esta regra, o botão
      // "Salvar" da aba Perfil falharia silenciosamente no servidor.
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // students/{studentId}
    //
    // Cadastro (roster) de alunos, gerenciado nesta fase por admins e
    // professores. Desde a Tarefa 2 (Fase 1 pós-auditoria V8), o
    // documento pode carregar um campo `uid` que o liga à conta de
    // Authentication do próprio aluno (`uid: null` = aluno ainda sem
    // conta vinculada, cadastrado antes desta mudança ou aguardando
    // migração). Isso é o que permite a extensão de leitura abaixo,
    // pré-requisito do Portal do Aluno (Tarefa 3).
    //
    // - LEITURA: admin/teacher com conta ativa continuam podendo ler
    //   qualquer aluno, como antes. Além disso, o PRÓPRIO aluno
    //   autenticado pode ler o SEU documento (`resource.data.uid ==
    //   request.auth.uid`) — nunca o de outro aluno, e nunca uma
    //   listagem (uma query `where uid == ...` funciona porque o
    //   Firestore aplica esta regra por documento, mas o cliente
    //   nunca deve fazer `list` sem esse filtro).
    // - ESCRITA (criar/editar): apenas admin/teacher com conta ativa.
    //   O aluno nunca escreve no próprio registro por aqui.
    // - EXCLUSÃO: restrita a admin, para evitar que um professor
    //   remova permanentemente o cadastro de um aluno por engano.
    // ---------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isSignedIn() && (isActiveStaff() || resource.data.uid == request.auth.uid);
      allow create, update: if isActiveStaff();
      allow delete: if isActiveAdmin();
    }

    // ---------------------------------------------------------------
    // classes/{classId}
    //
    // Cadastro de turmas (Fase 7). A quantidade de alunos exibida na
    // listagem é calculada no cliente a partir de `students.turma`
    // (texto livre) — não há um campo de contagem armazenado aqui, e
    // por isso nenhuma regra adicional é necessária além da leitura
    // de `students`, já coberta acima.
    //
    // Mesma política de acesso de `students`: admin/teacher ativos
    // podem ler/criar/editar; apenas admin pode excluir.
    // ---------------------------------------------------------------
    match /classes/{classId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if isActiveAdmin();
    }

    // ---------------------------------------------------------------
    // disciplines/{disciplineId}
    //
    // Cadastro de disciplinas. A relação com turmas é feita por IDs
    // (`classIds`, referenciando `classes/{classId}`) e a quantidade de
    // alunos exibida na UI é derivada no cliente a partir de
    // `students.turma`, assim como acontece em `classes` — por isso
    // nenhuma regra adicional é necessária além da leitura de
    // `students`/`classes`, já cobertas acima.
    //
    // Mesma política de acesso de `classes`: admin/teacher ativos podem
    // ler/criar/editar; apenas admin pode excluir.
    //
    // LEITURA (Tarefa 3, Fase 1 pós-auditoria V8): também liberada para
    // qualquer aluno com conta ativa. `disciplines` não é um dado
    // pessoal de nenhum aluno específico (é o catálogo de
    // disciplinas/turmas/professores da instituição, igual a um
    // catálogo de curso) — diferente de `grades`/`attendanceRecords`,
    // aqui não existe "registro de outro aluno" para vazar, então não
    // há necessidade (nem como, na prática: a tela de Boletim do aluno
    // lista as disciplinas da SUA turma, não de um aluno específico)
    // de escopar por `studentId`. Sem esta extensão,
    // `boletimService.getStudentBoletim` (reaproveitado pelo Portal do
    // Aluno) falharia ao chamar `getDisciplines()` para montar a lista
    // de disciplinas da turma do aluno.
    //
    // RESTRIÇÃO (item 13 do plano V8): um professor NÃO pode alterar o
    // campo `teacherId` de uma disciplina. Sem isso, o escopo por
    // disciplina introduzido em assessments/grades/attendanceSessions/
    // attendanceRecords (`canWriteAcademicRecord`/`isOwnDiscipline`,
    // acima) seria trivialmente contornável: bastaria um professor
    // reatribuir `teacherId` para si mesmo em qualquer disciplina para
    // ganhar acesso de escrita a ela. Admins continuam podendo
    // reatribuir o professor responsável normalmente.
    // ---------------------------------------------------------------
    match /disciplines/{disciplineId} {
      allow read: if isActiveStaff() || isActiveStudent();
      allow create: if isActiveStaff();
      allow update: if isActiveAdmin() ||
        (isActiveStaff() && request.resource.data.teacherId == resource.data.teacherId);
      allow delete: if isActiveAdmin();
    }

    // ---------------------------------------------------------------
    // assessments/{assessmentId}
    //
    // Avaliações (Prova 1, Trabalho, etc.) de um contexto disciplina +
    // turma + bimestre — parte da funcionalidade de Notas.
    //
    // LEITURA: ainda admin/teacher ativos em geral (sem escopo por
    // disciplina) — a tela de Notas depende de listar
    // turmas/disciplinas disponíveis nos filtros antes de saber qual
    // professor está "dono" de qual; restringir a leitura exigiria
    // primeiro adaptar a UI para filtrar os seletores por professor
    // logado, o que não foi feito nesta etapa (ver relatório final,
    // seção "Pendências").
    //
    // ESCRITA (criar/editar/excluir avaliação — inclui a permissão de
    // exclusão por professor, mantida do comportamento anterior):
    // restrita a admin OU ao professor responsável pela disciplina
    // (`canWriteAcademicRecord`, item 13 do plano V8 — menor privilégio
    // necessário). Antes, qualquer professor ativo podia escrever em
    // avaliações de QUALQUER disciplina, mesmo sem estar vinculado a
    // ela.
    // ---------------------------------------------------------------
    // ESCOPO DE LEITURA (Etapa 7 do plano multi-role — fecha o item
    // registrado como pendente: "assessments ainda libera leitura
    // ampla para qualquer isActiveStaff()"). Até aqui, leitura era
    // `isActiveStaff()` sozinho: qualquer professor ativo podia LER
    // avaliações de disciplinas de OUTROS professores (a barreira real
    // era só na ESCRITA, via `canWriteAcademicRecord`). Agora: admin
    // continua irrestrito; professor só lê quando é o dono da
    // disciplina (`isOwnDiscipline`, mesma função já usada na escrita).
    // COMPATIBILIDADE COM QUERIES: exige que toda consulta de professor
    // filtre por um `disciplineId` FIXO (`where('disciplineId','==',
    // id)`), nunca uma consulta ampla do ano letivo inteiro — ver
    // `assessmentService.getAssessmentsByDisciplineIds` (uma consulta
    // por disciplina, nunca `in`) e `teacherOverviewService`/
    // `NotesPage`/`ReportsPage`, atualizados para esse padrão.
    match /assessments/{assessmentId} {
      allow read: if isActiveAdmin() ||
        (isActiveStaff() && isOwnDiscipline(resource.data.disciplineId));
      // Validação de payload (Tarefa 1, pós-auditoria V8): `weight`,
      // quando presente, precisa ser > 0 — ver `isValidAssessmentWeight()`.
      allow create: if canWriteAcademicRecord(request.resource.data.disciplineId) &&
        isValidAssessmentWeight();
      // UPDATE checa a disciplina ATUAL (resource) E a disciplina do
      // payload enviado (request.resource) — evita que um professor
      // "sequestre" uma avaliação de outra disciplina apenas
      // reatribuindo o campo `disciplineId` para uma disciplina sua no
      // payload de update.
      allow update: if canWriteAcademicRecord(resource.data.disciplineId) &&
        canWriteAcademicRecord(request.resource.data.disciplineId) &&
        isValidAssessmentWeight();
      allow delete: if canWriteAcademicRecord(resource.data.disciplineId);
    }

    // ---------------------------------------------------------------
    // grades/{gradeId}
    //
    // Notas individuais (aluno + avaliação). O ID do documento passou a
    // ser determinístico (`{studentId}_{assessmentId}` — ver
    // `gradeService.buildGradeId`, item 3 do plano V8), o que não muda
    // nada aqui: a política de segurança já era, e continua sendo,
    // resolvida a partir do perfil do requisitante e da disciplina
    // vinculada, nunca do ID do documento.
    //
    // LEITURA: desde a Etapa 7, staff só lê a nota quando é ADMIN ou
    // quando é o professor DONO da disciplina daquela nota
    // (`isOwnDiscipline` — mesmo fechamento aplicado a `assessments`
    // acima). O PRÓPRIO aluno também pode ler as SUAS notas — nunca as
    // de outro aluno — via `isOwnStudentRecord`, que resolve
    // `studentId` (ID do documento em `students`) até o `uid` de Auth.
    // Ver a nota de compatibilidade com `list` em `isOwnStudentRecord`:
    // o cliente (aluno) só pode consultar filtrando
    // `where('studentId', '==', <seu próprio studentId>)`, nunca o
    // contexto inteiro (disciplina+turma+bimestre, que inclui outros
    // alunos) — ver `gradeService.getGradesByContext`.
    // ESCRITA: restrita a admin OU ao professor responsável pela
    // disciplina da nota (item 13). O aluno nunca escreve em `grades`.
    // ---------------------------------------------------------------
    match /grades/{gradeId} {
      allow read: if isActiveAdmin() ||
        (isActiveStaff() && isOwnDiscipline(resource.data.disciplineId)) ||
        isOwnStudentRecord(resource.data.studentId);
      // Validação de payload (Tarefa 1, pós-auditoria V8): `score`
      // precisa ser `null` (nota não lançada) ou um número em 0–10 —
      // ver `isValidScore()`. Antes desta validação, era possível
      // gravar `score: 15` ou `score: -3` diretamente via API,
      // contornando o limite que só existia no formulário do frontend.
      allow create: if canWriteAcademicRecord(request.resource.data.disciplineId) &&
        isValidScore(request.resource.data.score);
      allow update: if canWriteAcademicRecord(resource.data.disciplineId) &&
        canWriteAcademicRecord(request.resource.data.disciplineId) &&
        isValidScore(request.resource.data.score);
      allow delete: if canWriteAcademicRecord(resource.data.disciplineId);
    }

    // ---------------------------------------------------------------
    // attendanceSessions/{sessionId}
    //
    // Uma aula (data letiva) de um contexto disciplina + turma +
    // bimestre — parte da funcionalidade de Frequência. Mesmo papel de
    // `assessments` em Notas, e mesma política de acesso (item 13):
    // leitura por qualquer staff ativo; escrita restrita a admin OU ao
    // professor responsável pela disciplina.
    // ---------------------------------------------------------------
    // Uma aula (data letiva) de um contexto disciplina + turma +
    // bimestre — parte da funcionalidade de Frequência. Mesmo papel de
    // `assessments` em Notas, e mesma política de acesso (item 13 +
    // fechamento da Etapa 7): leitura por admin OU pelo professor
    // dono da disciplina (`isOwnDiscipline`); escrita restrita a admin
    // OU ao professor responsável pela disciplina.
    // ---------------------------------------------------------------
    match /attendanceSessions/{sessionId} {
      allow read: if isActiveAdmin() ||
        (isActiveStaff() && isOwnDiscipline(resource.data.disciplineId));
      allow create: if canWriteAcademicRecord(request.resource.data.disciplineId);
      allow update: if canWriteAcademicRecord(resource.data.disciplineId) &&
        canWriteAcademicRecord(request.resource.data.disciplineId);
      allow delete: if canWriteAcademicRecord(resource.data.disciplineId);
    }

    // ---------------------------------------------------------------
    // attendanceRecords/{recordId}
    //
    // Presença individual (aluno + aula: "present"/"absent"). ID do
    // documento agora determinístico (`{studentId}_{sessionId}` — ver
    // `attendanceRecordService.buildAttendanceRecordId`, item 3/8 do
    // plano V8). Mesma política de `attendanceSessions` (item 13):
    // leitura por qualquer staff ativo; escrita restrita a admin OU ao
    // professor responsável pela disciplina.
    //
    // LEITURA (Etapa 7): mesmo fechamento de `assessments`/`grades`
    // acima — admin lê tudo; professor só lê quando é dono da
    // disciplina do registro (`isOwnDiscipline`). O PRÓPRIO aluno pode
    // ler os SEUS registros de presença via `isOwnStudentRecord`, nunca
    // os de outro aluno, e apenas com uma query filtrada por
    // `studentId` (ver `attendanceRecordService.getRecordsByContext`).
    // ---------------------------------------------------------------
    match /attendanceRecords/{recordId} {
      allow read: if isActiveAdmin() ||
        (isActiveStaff() && isOwnDiscipline(resource.data.disciplineId)) ||
        isOwnStudentRecord(resource.data.studentId);
      // Validação de payload (Tarefa 1, pós-auditoria V8): `status`
      // precisa ser um dos valores do enum `AttendanceRecordStatus`
      // (`src/types/attendance.ts`) — ver `isValidAttendanceStatus()`.
      allow create: if canWriteAcademicRecord(request.resource.data.disciplineId) &&
        isValidAttendanceStatus(request.resource.data.status);
      allow update: if canWriteAcademicRecord(resource.data.disciplineId) &&
        canWriteAcademicRecord(request.resource.data.disciplineId) &&
        isValidAttendanceStatus(request.resource.data.status);
      allow delete: if canWriteAcademicRecord(resource.data.disciplineId);
    }

    // ---------------------------------------------------------------
    // academicSettings/{schoolYear}
    //
    // Regras acadêmicas configuráveis por ano letivo (item 6/7 do
    // plano V8 — média mínima, recuperação, frequência mínima,
    // quantidade de bimestres). O ID do documento é o próprio ano
    // letivo.
    //
    // LEITURA: qualquer staff ativo (admin/teacher) — Notas, Boletim e
    // Dashboard precisam ler a configuração para calcular situação
    // acadêmica corretamente. Desde a Tarefa 3 (Fase 1 pós-auditoria
    // V8), também liberada para aluno com conta ativa: assim como
    // `disciplines`, este documento não é um dado pessoal de nenhum
    // aluno (é a régua institucional do ano letivo) — o Portal do
    // Aluno precisa dele para calcular a MESMA situação acadêmica que
    // staff vê (`boletimService.getStudentBoletim`, reaproveitado sem
    // duplicar a fórmula).
    // ESCRITA: restrita a admin. Definir a média mínima de aprovação
    // ou a frequência mínima exigida é uma decisão institucional, não
    // uma preferência de professor (nem, com mais razão, de aluno).
    // ---------------------------------------------------------------
    match /academicSettings/{schoolYear} {
      allow read: if isActiveStaff() || isActiveStudent();
      allow create, update, delete: if isActiveAdmin();
    }

    // ---------------------------------------------------------------
    // auditLogs/{logId}
    //
    // Trilha de auditoria (item 14 do plano V8) para alteração de
    // nota, exclusão de avaliação e alteração de frequência — ver
    // `services/audit/auditService.ts`.
    //
    // CRIAÇÃO: qualquer staff ativo pode registrar um evento (é o
    // próprio ato de editar uma nota/frequência ou excluir uma
    // avaliação que gera o log — sempre com `actorId` igual ao UID do
    // requisitante, nunca em nome de outra pessoa).
    // LEITURA: restrita a admin — auditoria é uma ferramenta de
    // supervisão, não algo que cada professor deve enxergar sobre os
    // demais.
    // ATUALIZAÇÃO/EXCLUSÃO: nunca pelo cliente — um log de auditoria
    // que pode ser editado ou apagado pelos próprios usuários deixa de
    // ser confiável como trilha de auditoria.
    // ---------------------------------------------------------------
    match /auditLogs/{logId} {
      allow create: if isActiveStaff() && request.resource.data.actorId == request.auth.uid;
      allow read: if isActiveAdmin();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Notificações (Fase 5 do plano de evolução — ver
    // `services/notifications/notificationService.ts` e
    // `types/notification.ts`).
    //
    // LEITURA: um usuário só pode ler as PRÓPRIAS notificações
    // (`recipientUid == request.auth.uid`). Isso vale tanto para
    // `get` de um documento quanto para `list`/queries — toda query no
    // service já filtra por `where("recipientUid", "==", uid)`, então
    // essa regra nunca barra o uso legítimo, só impede um usuário de
    // tentar ler notificações de outra pessoa.
    //
    // CRIAÇÃO: restrita a staff ativo (admin/professor), que é quem
    // dispara os eventos que geram notificação (lançar nota, vincular
    // disciplina, cadastrar professor...). Um aluno nunca cria
    // notificação para ninguém, nem para si mesmo. Isso é
    // deliberadamente mais permissivo que "só o próprio destinatário
    // grava", porque quem cria a notificação nunca é o destinatário
    // (ex.: o professor lança a nota, o ALUNO é quem recebe).
    //
    // ATUALIZAÇÃO: só o destinatário pode alterar sua notificação, e
    // apenas o campo `read` — impede que o destinatário reescreva
    // título/mensagem/link de uma notificação que já recebeu.
    //
    // EXCLUSÃO: não exposta na UI desta etapa; mantida bloqueada, no
    // mesmo espírito de `auditLogs`, até haver necessidade real.
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isActiveStaff();
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Nenhuma outra coleção existe ainda. Por padrão, o Firestore nega
    // tudo que não tem uma regra explícita — não é necessário (nem
    // recomendado) adicionar um "match /{document=**}" de bloqueio,
    // pois isso já é o comportamento padrão de segurança.
  }
}
